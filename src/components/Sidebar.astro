---
import CategoryNav from './CategoryNav.astro';
import DarkModeToggle from './DarkModeToggle.astro';
import SearchTrigger from './SearchTrigger.astro';
import { SITE_TITLE } from '../lib/site';
---

<aside class="hidden md:flex md:flex-col md:w-64 md:shrink-0 md:sticky md:top-0 md:h-screen md:overflow-y-auto border-r border-gray-300 dark:border-gray-700 bg-white dark:bg-slate-900">
  <a href="/" class="font-mono text-xl font-bold px-6 py-6 border-b border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors">
    {SITE_TITLE}
  </a>
  <div class="flex-1 px-4 py-4">
    <SearchTrigger />
    <CategoryNav />
  </div>
  <div class="border-t border-gray-300 dark:border-gray-700 px-4 py-4 flex justify-center">
    <DarkModeToggle />
  </div>
</aside>
