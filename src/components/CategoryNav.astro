---
import { CATEGORY_LABELS } from '../lib/categories';
import { getCategoryCounts } from '../lib/notes';

const pathname = new URL(Astro.request.url).pathname;

const categories = [
  { key: 'projects', label: CATEGORY_LABELS.projects },
  { key: 'backend', label: CATEGORY_LABELS.backend },
  { key: 'infrastructure', label: CATEGORY_LABELS.infrastructure },
  { key: 'database', label: CATEGORY_LABELS.database },
  { key: 'frontend', label: CATEGORY_LABELS.frontend },
  { key: 'leadership', label: CATEGORY_LABELS.leadership },
  { key: 'others', label: CATEGORY_LABELS.others },
];

const counts = await getCategoryCounts();

const isCategoryActive = (category: { key: string }) =>
  pathname === `/${category.key}` || pathname.startsWith(`/${category.key}/`);
---

<div class="category-nav">
  <span class="nav-eyebrow">Categories</span>
  {categories.map((category) => (
    <a href={`/${category.key}/`} class={`nav-category-link ${isCategoryActive(category) ? 'active' : ''}`}>
      <span class="nav-category-label">{category.label}</span>
      <span class="nav-category-count">{counts[category.key as keyof typeof counts]}</span>
    </a>
  ))}
</div>

<style>
  .category-nav {
    display: flex;
    flex-direction: column;
  }

  .nav-eyebrow {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9ca3af;
    padding: 0 1rem;
    margin: 0 0 0.75rem;
  }

  html.dark .nav-eyebrow {
    color: #64748b;
  }

  .nav-category-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 1rem 0.55rem 1.15rem;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.875rem;
    color: #4b5563;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .nav-category-count {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    background: #e5e7eb;
    color: #6b7280;
  }

  html.dark .nav-category-count {
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
  }

  .nav-category-link.active .nav-category-count {
    background: #dbeafe;
    color: #1d4ed8;
  }

  html.dark .nav-category-link.active .nav-category-count {
    background: rgba(96, 165, 250, 0.18);
    color: #93c5fd;
  }

  html.dark .nav-category-link {
    color: #94a3b8;
  }

  .nav-category-link:hover {
    background: #f1f5f9;
    color: #1f2937;
    border-left-color: #cbd5e1;
    text-decoration: none;
  }

  html.dark .nav-category-link:hover {
    background: rgba(148, 163, 184, 0.08);
    color: #e2e8f0;
    border-left-color: #475569;
  }

  .nav-category-link.active {
    background: #eff6ff;
    color: #1d4ed8;
    border-left-color: #2563eb;
    font-weight: 600;
  }

  html.dark .nav-category-link.active {
    background: rgba(96, 165, 250, 0.12);
    color: #93c5fd;
    border-left-color: #60a5fa;
  }
</style>
