---
---

<div id="search-overlay" class="search-overlay hidden" role="dialog" aria-modal="true" aria-label="Search notes">
  <div id="search-backdrop" class="search-backdrop"></div>
  <div class="search-panel">
    <div class="search-input-row">
      <svg class="search-input-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search notes..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-esc-hint">Esc</kbd>
    </div>
    <div id="search-results" class="search-results"></div>
    <p id="search-empty" class="search-empty hidden">No results found.</p>
    <p id="search-hint" class="search-empty">Start typing to search titles, tags, and note content.</p>
  </div>
</div>

<style is:global>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 10vh 1rem 1rem;
  }

  .search-overlay.hidden {
    display: none;
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
  }

  .search-panel {
    position: relative;
    width: 100%;
    max-width: 36rem;
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  html.dark .search-panel {
    background: #0f172a;
    border-color: #334155;
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid #e5e7eb;
  }

  html.dark .search-input-row {
    border-color: #334155;
  }

  .search-input-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: #9ca3af;
  }

  html.dark .search-input-icon {
    color: #64748b;
  }

  #search-input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.95rem;
    color: #111827;
  }

  html.dark #search-input {
    color: #f1f5f9;
  }

  #search-input::placeholder {
    color: #9ca3af;
  }

  html.dark #search-input::placeholder {
    color: #64748b;
  }

  .search-esc-hint {
    flex-shrink: 0;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.15rem 0.4rem;
    border-radius: 0.35rem;
    background: #f1f5f9;
    color: #6b7280;
  }

  html.dark .search-esc-hint {
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
  }

  .search-results {
    overflow-y: auto;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .search-result {
    display: block;
    padding: 0.7rem 0.8rem;
    border-radius: 0.5rem;
    text-decoration: none !important;
    color: inherit;
    border: 1px solid transparent;
    background: #f8fafc;
  }

  html.dark .search-result {
    background: rgba(148, 163, 184, 0.05);
  }

  .search-result:hover {
    border-color: #cbd5e1;
  }

  html.dark .search-result:hover {
    border-color: #475569;
  }

  .search-result.active {
    background: #eff6ff;
    border-color: #93c5fd;
  }

  html.dark .search-result.active {
    background: rgba(96, 165, 250, 0.12);
    border-color: #3b82f6;
  }

  .search-result-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.3rem;
  }

  .search-result-title {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827 !important;
    line-height: 1.3;
  }

  html.dark .search-result-title {
    color: #f1f5f9 !important;
  }

  .search-result-category {
    flex-shrink: 0;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #2563eb !important;
    background: #dbeafe;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    line-height: 1.5;
  }

  html.dark .search-result-category {
    color: #93c5fd !important;
    background: rgba(96, 165, 250, 0.15);
  }

  .search-result-snippet {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.4;
    color: #6b7280 !important;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  html.dark .search-result-snippet {
    color: #94a3b8 !important;
  }

  .search-result-snippet mark {
    background: #fef08a;
    color: inherit;
    border-radius: 0.15rem;
  }

  html.dark .search-result-snippet mark {
    background: rgba(250, 204, 21, 0.35);
  }

  .search-empty {
    padding: 1.25rem 1rem;
    text-align: center;
    font-size: 0.85rem;
    color: #9ca3af;
  }

  html.dark .search-empty {
    color: #64748b;
  }

  .search-empty.hidden {
    display: none;
  }
</style>

<script>
  import Fuse from 'fuse.js';
  import type { FuseResult } from 'fuse.js';

  interface SearchDoc {
    title: string;
    description: string;
    category: string;
    tags: string[];
    href: string;
    content: string;
  }

  const overlay = document.getElementById('search-overlay')!;
  const backdrop = document.getElementById('search-backdrop')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsEl = document.getElementById('search-results')!;
  const emptyEl = document.getElementById('search-empty')!;
  const hintEl = document.getElementById('search-hint')!;

  let fuse: Fuse<SearchDoc> | null = null;
  let indexLoaded = false;
  let activeIndex = -1;

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  async function ensureIndex(): Promise<void> {
    if (indexLoaded) return;
    indexLoaded = true;
    const res = await fetch('/search-index.json');
    const docs: SearchDoc[] = await res.json();
    fuse = new Fuse(docs, {
      includeScore: true,
      includeMatches: true,
      threshold: 0.35,
      ignoreLocation: true,
      minMatchCharLength: 2,
      keys: [
        { name: 'title', weight: 0.45 },
        { name: 'tags', weight: 0.2 },
        { name: 'description', weight: 0.2 },
        { name: 'content', weight: 0.15 },
      ],
    });
  }

  function buildSnippet(result: FuseResult<SearchDoc>): string {
    const { item, matches } = result;
    const contentMatch = matches?.find((m) => m.key === 'content');

    if (!contentMatch || !contentMatch.value || contentMatch.indices.length === 0) {
      return escapeHtml(item.description);
    }

    const text = contentMatch.value;
    const [start, end] = contentMatch.indices[0];
    const contextRadius = 60;
    const from = Math.max(0, start - contextRadius);
    const to = Math.min(text.length, end + 1 + contextRadius);

    const prefix = from > 0 ? '…' : '';
    const suffix = to < text.length ? '…' : '';
    const before = escapeHtml(text.slice(from, start));
    const match = escapeHtml(text.slice(start, end + 1));
    const after = escapeHtml(text.slice(end + 1, to));

    return `${prefix}${before}<mark>${match}</mark>${after}${suffix}`;
  }

  function updateActive(items: Element[]): void {
    items.forEach((el, i) => el.classList.toggle('active', i === activeIndex));
    items[activeIndex]?.scrollIntoView({ block: 'nearest' });
  }

  function render(results: FuseResult<SearchDoc>[]): void {
    const query = input.value.trim();
    hintEl.classList.toggle('hidden', query.length > 0);

    if (!results.length) {
      resultsEl.innerHTML = '';
      emptyEl.classList.toggle('hidden', query.length === 0);
      activeIndex = -1;
      return;
    }

    emptyEl.classList.add('hidden');
    activeIndex = 0;

    resultsEl.innerHTML = results
      .slice(0, 5)
      .map(
        (r, i) => `
        <a href="${r.item.href}" class="search-result${i === 0 ? ' active' : ''}">
          <div class="search-result-top">
            <span class="search-result-title">${escapeHtml(r.item.title)}</span>
            <span class="search-result-category">${escapeHtml(r.item.category)}</span>
          </div>
          <p class="search-result-snippet">${buildSnippet(r)}</p>
        </a>
      `
      )
      .join('');
  }

  async function handleInput(): Promise<void> {
    await ensureIndex();
    const query = input.value.trim();
    if (!query) {
      render([]);
      return;
    }
    render(fuse!.search(query));
  }

  function open(): void {
    overlay.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    input.value = '';
    resultsEl.innerHTML = '';
    activeIndex = -1;
    emptyEl.classList.add('hidden');
    hintEl.classList.remove('hidden');
    ensureIndex();
    input.focus();
  }

  function close(): void {
    overlay.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  window.addEventListener('open-search', open);
  backdrop.addEventListener('click', close);
  input.addEventListener('input', handleInput);

  input.addEventListener('keydown', (e) => {
    const items = Array.from(resultsEl.querySelectorAll('.search-result'));
    if (e.key === 'ArrowDown') {
      if (!items.length) return;
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, items.length - 1);
      updateActive(items);
    } else if (e.key === 'ArrowUp') {
      if (!items.length) return;
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
      updateActive(items);
    } else if (e.key === 'Enter') {
      const el = items[activeIndex] as HTMLAnchorElement | undefined;
      if (el) {
        e.preventDefault();
        window.location.href = el.href;
      }
    }
  });

  document.addEventListener('keydown', (e) => {
    const isShortcut = e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey);
    if (isShortcut) {
      e.preventDefault();
      open();
      return;
    }
    if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
      close();
    }
  });
</script>
