---
interface Props {
  category: string;
  label: string;
  description: string;
  count: number;
  href: string;
}

const { label, description, count, href } = Astro.props;
---

<a href={href} class="landing-card hover:shadow-lg hover:border-blue-400 dark:hover:border-blue-500 transition-all">
  <div class="flex justify-between items-start gap-4">
    <div class="flex-1">
      <h3 class="mt-0">{label}</h3>
      <p>{description}</p>
    </div>
    <div class="text-2xl font-bold text-blue-600 dark:text-blue-400 flex-shrink-0">
      {count}
    </div>
  </div>
</a>
