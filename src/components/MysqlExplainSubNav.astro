---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { href: '/database/mysql-explain', label: 'Overview' },
  { href: '/database/mysql-explain/explain', label: 'EXPLAIN Basics' },
  { href: '/database/mysql-explain/optimizer', label: 'Query Optimizer' },
  { href: '/database/mysql-explain/indexes', label: 'Indexes' },
  { href: '/database/mysql-explain/practice', label: 'Practice' },
];
---

<nav class="sticky top-0 z-40 bg-white dark:bg-slate-900 border-b border-gray-200 dark:border-gray-700">
  <div class="max-w-4xl mx-auto px-4 md:px-8">
    <ul class="flex flex-wrap gap-3 py-3">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class={`font-mono text-xs font-medium px-3 py-1.5 rounded transition-all ${
              pathname === item.href || (item.href !== '/database/mysql-explain' && pathname.startsWith(item.href))
                ? 'bg-blue-500/20 dark:bg-blue-500/30 text-blue-700 dark:text-blue-300 border-b-2 border-blue-600 dark:border-blue-400'
                : 'bg-gray-400/10 dark:bg-gray-400/10 text-gray-700 dark:text-gray-300 hover:bg-gray-400/15 dark:hover:bg-gray-400/15'
            }`}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
