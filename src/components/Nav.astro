---
import { CATEGORY_LABELS } from '../lib/categories';

const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { href: '/', label: 'Home' },
  ...Object.entries(CATEGORY_LABELS).map(([key, label]) => ({
    href: `/${key}`,
    label,
  })),
];
---

<nav class="sticky top-0 z-50 bg-white dark:bg-slate-900">
  <div class="max-w-4xl mx-auto px-4 md:px-8">
    <ul class="flex flex-wrap gap-3 py-4">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class={`font-mono text-sm font-medium px-4 py-2 rounded transition-all ${
              pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href))
                ? 'bg-blue-500/20 dark:bg-blue-500/30 text-blue-700 dark:text-blue-300 border-b-2 border-blue-600 dark:border-blue-400'
                : 'bg-gray-400/10 dark:bg-gray-400/10 text-gray-700 dark:text-gray-300 hover:bg-gray-400/15 dark:hover:bg-gray-400/15'
            }`}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
