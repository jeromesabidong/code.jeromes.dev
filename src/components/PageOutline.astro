---
interface Section {
  id: string;
  label: string;
  children?: { id: string; label: string }[];
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
---

<details class="border border-gray-300 dark:border-gray-700 rounded-lg p-4 mb-6 bg-gray-50 dark:bg-gray-800">
  <summary class="cursor-pointer font-mono font-semibold text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
    Table of Contents
  </summary>

  <nav class="mt-4 space-y-2">
    {sections.map((section) => (
      <div>
        <a
          href={`#${section.id}`}
          class="block font-mono text-sm text-blue-600 dark:text-blue-400 hover:underline py-1"
        >
          {section.label}
        </a>
        {section.children && section.children.length > 0 && (
          <ul class="list-none space-y-1 ml-4 mt-1">
            {section.children.map((child) => (
              <li>
                <a
                  href={`#${child.id}`}
                  class="font-mono text-xs text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors hover:underline"
                >
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </nav>
</details>
