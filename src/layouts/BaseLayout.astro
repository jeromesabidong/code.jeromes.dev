---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A developer-friendly reference for MySQL EXPLAIN and query optimization" />
    <title>{title} - MySQL EXPLAIN</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; 2026 MySQL EXPLAIN Reference. Built with Astro.</p>
    </footer>
  </body>
</html>
