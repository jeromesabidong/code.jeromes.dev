---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import ViewToggle from '../../components/ViewToggle.astro';
import type { Category } from '../../lib/categories';
import { CATEGORIES, CATEGORY_LABELS, CATEGORY_DESCRIPTIONS } from '../../lib/categories';
import { getNotesByCategory } from '../../lib/notes';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category },
  }));
}

const category = Astro.params.category as Category;
const categoryLabel = CATEGORY_LABELS[category];
const categoryDescription = CATEGORY_DESCRIPTIONS[category];
const notes = await getNotesByCategory(category);
---

<BaseLayout title={categoryLabel} description={categoryDescription}>
  <h1>{categoryLabel}</h1>
  <p>{categoryDescription}</p>

  {notes.length > 0 ? (
    <>
      <div class="flex justify-end mb-4">
        <ViewToggle targetId="notes-container" />
      </div>
      <div id="notes-container" class="landing-grid">
        {notes.map((note) => (
          <NoteCard
            title={note.title}
            description={note.description}
            date={note.date}
            tags={note.tags}
            href={note.href}
          />
        ))}
      </div>
      <script is:inline>
        (function () {
          var stored = localStorage.getItem('notesViewMode');
          if (stored === 'list') {
            var el = document.getElementById('notes-container');
            if (el) el.classList.add('list-view');
          }
        })();
      </script>
    </>
  ) : (
    <div class="text-center py-12">
      <p class="text-gray-500 dark:text-gray-400">
        No notes in this category yet. Check back soon!
      </p>
    </div>
  )}
</BaseLayout>
