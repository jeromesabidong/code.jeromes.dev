---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);

  return notes.map((entry) => {
    const slugParts = entry.id.split('/');
    const slug = slugParts.length > 1 ? slugParts[1] : entry.id;
    return {
      params: {
        category: entry.data.category,
        slug: slug,
      },
      props: { entryId: entry.id },
    };
  });
}

interface Props {
  entryId: string;
}

const { entryId } = Astro.props;
const entry = await getEntry('notes', entryId);
if (!entry) {
  return Astro.redirect('/');
}
const { Content } = await render(entry);
const { title, description } = entry.data;
---

<BaseLayout title={title} description={description}>
  <article>
    <h1>{title}</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">{description}</p>
    <Content />
  </article>
</BaseLayout>
