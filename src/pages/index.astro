---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { CATEGORIES, CATEGORY_LABELS, CATEGORY_DESCRIPTIONS } from '../lib/categories';
import { getCategoryCounts } from '../lib/notes';

const counts = await getCategoryCounts();
---

<BaseLayout title="Home">
  <h1>Code Notes</h1>
  <p>
    A personal knowledge base across backend, infrastructure, database, frontend, and leadership topics. Explore categories below or use the navigation to find what you're looking for.
  </p>

  <div class="landing-grid">
    {CATEGORIES.map((category) => (
      <CategoryCard
        category={category}
        label={CATEGORY_LABELS[category]}
        description={CATEGORY_DESCRIPTIONS[category]}
        count={counts[category]}
        href={`/${category}`}
      />
    ))}
  </div>
</BaseLayout>
